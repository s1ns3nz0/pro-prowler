# Pro-Prowler — Environment Configuration

# --- Server ---
# Port to run the server on
PORT=8000

# API key for authenticating API requests (optional — disabled if unset)
# IAC_RISK_API_KEY=

# --- LLM Provider ---
# Options: anthropic, openai, ollama
LLM_PROVIDER=anthropic

# Model override (optional — defaults per provider)
# LLM_MODEL=

# Anthropic API key (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI API key (required if LLM_PROVIDER=openai)
# OPENAI_API_KEY=

# Ollama base URL (required if LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# --- GitHub Integration ---
# Personal Access Token with repo scope (for fix PRs and repo scanning)
GITHUB_TOKEN=
